---
import Icon from './Icon.astro';
import { getSite } from '../lib/content';
const site = getSite();
---
<header class="header" data-header>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <img src="/logo-mark.svg" alt="" width="52" height="52" />
      <span>W&amp;E Health Institute</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="call" href={site.phone_href}><Icon name="phone" />{site.phone}</a>
      <a class="btn btn-primary book" href={site.booking_url}>Book online</a>
      <button class="menu" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu>
        <span class="visually-hidden">Menu</span>
        <Icon name="menu" class="i-open" /><Icon name="x" class="i-close" />
      </button>
    </div>
  </div>
  <nav class="drawer" id="mobile-nav" aria-label="Main" hidden>
    <div class="wrap">
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <div class="drawer-contact">
        <a class="call" href={site.phone_href}><Icon name="phone" />{site.phone}</a>
        <p>{site.hours_short} · {site.address_line2}</p>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = header.querySelector<HTMLButtonElement>('[data-menu]')!;
  const drawer = header.querySelector<HTMLElement>('#mobile-nav')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    drawer.hidden = !open;
    header.classList.toggle('is-open', open);
  };
  btn.addEventListener('click', () => setOpen(drawer.hidden));
  // Lock page scroll while the full-height menu is open
  new MutationObserver(() => { document.body.style.overflow = drawer.hidden ? '' : 'hidden'; }).observe(drawer, { attributes: true, attributeFilter: ['hidden'] });
  drawer.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .header.is-scrolled, .header.is-open { border-bottom-color: var(--rule); }
  .bar { display: flex; align-items: center; gap: 24px; height: 76px; }
  .brand {
    display: flex; align-items: center; gap: 14px; text-decoration: none;
    font-family: var(--font-display); font-size: var(--step-1); letter-spacing: -0.01em; white-space: nowrap;
  }
  .brand img { width: 52px; height: 52px; }
  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .nav a { text-decoration: none; font-weight: 500; font-size: 0.975rem; color: var(--ink-2); }
  .nav a:hover { color: var(--ink); text-decoration: underline; }
  .actions { display: flex; align-items: center; gap: 20px; }
  .call {
    display: inline-flex; align-items: center; gap: 8px;
    font-weight: 600; text-decoration: none; white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .call :global(svg) { width: 17px; height: 17px; color: var(--jade); }
  .book { min-height: 46px; padding: 0 22px; }
  .menu {
    display: none; width: 46px; height: 46px; border-radius: 999px;
    border: 1px solid var(--rule); background: var(--paper); color: var(--ink);
    align-items: center; justify-content: center; cursor: pointer;
  }
  .menu :global(svg) { width: 22px; height: 22px; }
  .menu :global(.i-close), .is-open .menu :global(.i-open) { display: none; }
  .is-open .menu :global(.i-close) { display: block; }
  .drawer {
    position: fixed; inset: 64px 0 0 0; z-index: 49; overflow-y: auto;
    background: var(--paper); border-top: 1px solid var(--rule);
  }
  .drawer ul { list-style: none; margin: 0; padding: 8px 0 24px; }
  .drawer-contact { padding-block: 8px 120px; display: grid; gap: 8px; }
  .drawer-contact .call { display: inline-flex; font-size: 1.25rem; }
  .drawer-contact p { color: var(--ink-2); }
  .drawer li a {
    display: block; padding: 16px 0; border-bottom: 1px solid var(--rule);
    font-family: var(--font-display); font-size: var(--step-2); text-decoration: none;
  }

  @media (max-width: 1180px) { .actions .call { display: none; } }
  @media (max-width: 980px) {
    .nav { display: none; }
    .actions { margin-left: auto; }
    .menu { display: inline-flex; }
  }
  @media (max-width: 560px) {
    .bar { height: 64px; }
    .brand { font-size: var(--step-0); }
    .brand img { width: 42px; height: 42px; }
    .book { display: none; }
  }
</style>
