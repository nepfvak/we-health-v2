---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import BookBand from '../components/BookBand.astro';
import Icon from '../components/Icon.astro';
import { getReviews, getSite } from '../lib/content';

const reviews = getReviews();
const site = getSite();
---
<Base title="Patient reviews | W&E Health Institute" description="Read Google reviews from patients of W&E Health Institute, an acupuncture and Chinese medicine clinic in Cordova, TN.">
  <PageHeader
    title="In our patients’ words"
    lede="Reviews our patients have left on Google, shared with their words unchanged. Everyone’s experience is their own, and results vary from person to person."
  >
    <a class="text-link" href={site.reviews_url}>Read all reviews on Google<Icon name="arrow-right" /></a>
  </PageHeader>
  <section class="section reviews">
    <div class="wrap">
      <div class="cols">
        {reviews.map((r) => (
          <figure>
            <div class="stars" role="img" aria-label="5 out of 5 stars">
              {[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}
            </div>
            <blockquote><p>“{r.quote}”</p></blockquote>
            <figcaption><strong>{r.name}</strong> · {r.source} review</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <BookBand />
</Base>

<style>
  .reviews { padding-top: 0; }
  .cols { columns: 3 320px; column-gap: clamp(32px, 4vw, 56px); }
  figure {
    break-inside: avoid; margin: 0 0 clamp(40px, 4vw, 56px);
    padding-top: 24px; border-top: 1px solid var(--ink);
  }
  .stars { display: flex; gap: 3px; color: var(--root); }
  .stars :global(svg) { width: 16px; height: 16px; fill: currentColor; stroke: none; }
  blockquote { margin: 16px 0 18px; }
  blockquote p { font-family: var(--font-display); font-size: var(--step-0); line-height: 1.65; }
  figcaption { font-size: var(--step--1); color: var(--ink-2); }
  figcaption strong { color: var(--ink); font-weight: 600; }
</style>
