---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import BookBand from '../../components/BookBand.astro';
import { photos } from '../../lib/images';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog | W&E Health Institute" description="Articles on acupuncture, Chinese medicine and wellbeing from the doctors at W&E Health Institute.">
  <PageHeader title="From our doctors" lede="Plain-language articles on acupuncture, Chinese medicine and looking after yourself." />
  <section class="section posts">
    <div class="wrap">
      <ul class="list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.data.slug}`}>
              <figure class="photo">
                {photos[p.data.image] && <Image src={photos[p.data.image]} alt="" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 360px" quality={82} />}
              </figure>
              <div class="text">
                <h2>{p.data.title}</h2>
                <p class="meta"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time> · {p.data.author}</p>
                <p class="ex">{p.data.excerpt}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <BookBand />
</Base>

<style>
  .posts { padding-top: 0; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .list a {
    display: grid; grid-template-columns: minmax(0, 360px) 1fr; gap: clamp(24px, 4vw, 56px); align-items: center;
    padding: clamp(28px, 3vw, 40px) 0; border-bottom: 1px solid var(--rule); text-decoration: none;
  }
  .photo { margin: 0; aspect-ratio: 3 / 2; border-radius: var(--radius-sm); overflow: hidden; background: var(--stone); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out); }
  .list a:hover .photo :global(img) { transform: scale(1.03); }
  .list a:hover h2 { text-decoration: underline; text-decoration-thickness: 1px; }
  .meta { font-size: var(--step--1); color: var(--ink-2); }
  h2 { font-size: var(--step-2); line-height: 1.2; }
  .meta { margin-top: 10px; }
  .ex { margin-top: 12px; color: var(--ink-2); max-width: 60ch; }
  @media (max-width: 760px) { .list a { grid-template-columns: 1fr; } }
</style>
