---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import BookBand from '../../components/BookBand.astro';
import Icon from '../../components/Icon.astro';
import { photos } from '../../lib/images';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} | W&E Health Institute`} description={post.data.excerpt}>
  <article>
    <header class="wrap head">
      <a class="text-link back" href="/blog"><Icon name="arrow-right" class="flip" />All articles</a>
      <h1>{post.data.title}</h1>
      <p class="meta"><time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time> · {post.data.author}</p>
    </header>
    {photos[post.data.image] && (
      <figure class="wrap photo-wrap">
        <div class="photo"><Image src={photos[post.data.image]} alt="" widths={[800, 1200, 1600, 2000, 2600]} sizes="(max-width: 1400px) 100vw, 1288px" quality={82} loading="eager" /></div>
      </figure>
    )}
    <div class="wrap body">
      <div class="prose"><Content /></div>
    </div>
  </article>
  <BookBand />
</Base>

<style>
  .head { padding-top: clamp(40px, 6vw, 80px); max-width: calc(68ch + 2 * var(--gutter)); }
  .back :global(.flip) { transform: rotate(180deg); }
  .back:hover :global(.flip) { transform: rotate(180deg) translateX(4px); }
  h1 { margin-top: 28px; font-size: var(--step-3); }
  .meta { margin-top: 16px; color: var(--ink-2); font-size: var(--step--1); }
  .photo-wrap { margin: clamp(32px, 4vw, 56px) auto 0; }
  .photo { aspect-ratio: 21 / 9; border-radius: var(--radius); overflow: hidden; background: var(--stone); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { padding-block: clamp(40px, 5vw, 72px) var(--section); max-width: calc(68ch + 2 * var(--gutter)); }
  @media (max-width: 560px) { .photo { aspect-ratio: 4 / 3; border-radius: var(--radius-sm); } }
</style>
