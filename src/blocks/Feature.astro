---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { photos } from '../lib/images';
import type { Block } from '../lib/content';

interface Props { blok: Block }
const { blok } = Astro.props;
---
<section class:list={['section', 'feature', blok.theme, `img-${blok.image_side}`]} id={blok.anchor}>
  <div class="wrap layout">
    <figure class="photo" data-reveal>
      <Image src={photos[blok.image]} alt={blok.image_alt} widths={[640, 960, 1280, 1600, 2000]} quality={82} sizes="(max-width: 900px) 100vw, 50vw" />
    </figure>
    <div class="copy">
      <h2 data-reveal>{blok.heading}</h2>
      <p class="body">{blok.body}</p>
      {blok.points?.length > 0 && (
        <ul>
          {blok.points.map((p: string) => <li><Icon name="check" />{p}</li>)}
        </ul>
      )}
      <a class="text-link" href={blok.cta_link}>{blok.cta_label}<Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .feature.stone { background: var(--stone); }
  .layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 112px); align-items: center; }
  .img-right .photo { order: 2; }
  .photo { margin: 0; border-radius: var(--radius); overflow: hidden; aspect-ratio: 5 / 4; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { margin-top: 24px; font-size: var(--step-1); line-height: 1.55; color: var(--ink-2); max-width: 50ch; }
  ul { list-style: none; margin: 28px 0 32px; padding: 0; display: grid; gap: 14px; }
  li { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start; }
  li :global(svg) { width: 20px; height: 20px; margin-top: 3px; color: var(--ink-2); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .img-right .photo { order: 0; }
    .photo { aspect-ratio: 16 / 10; }
  }
</style>
