---
import type { Block } from '../lib/content';

interface Props { blok: Block }
const { blok } = Astro.props;
---
<section class="section coverage">
  <div class="wrap layout">
    <h2 data-reveal>{blok.heading}</h2>
    <dl>
      {blok.items.map((item: Block) => (
        <div>
          <dt>{item.title}</dt>
          <dd>{item.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .coverage { background: var(--stone); }
  .layout { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 112px); }
  dl { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 clamp(24px, 4vw, 56px); }
  dl > div { padding: 24px 0; border-top: 1px solid var(--rule); }
  dt { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.2; }
  dd { margin: 8px 0 0; color: var(--ink-2); max-width: 38ch; }

  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { dl { grid-template-columns: 1fr; } }
</style>
