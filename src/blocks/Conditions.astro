---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { photos } from '../lib/images';
import type { Block } from '../lib/content';

interface Props { blok: Block }
const { blok } = Astro.props;
---
<section class="section conditions" id="conditions">
  <div class="wrap layout">
    <div class="side">
      <h2 data-reveal>{blok.heading}</h2>
      <p class="lede" data-reveal>{blok.intro}</p>
      <figure class="photo" data-reveal>
        <Image style={`object-position:${blok.image_position ?? '50% 50%'}`} src={photos[blok.image]} alt={blok.image_alt} widths={[640, 960, 1280, 1600]} quality={82} sizes="(max-width: 900px) 100vw, 40vw" />
      </figure>
    </div>
    <div class="main">
      <ul class="list">
        {blok.items.map((item: Block) => (
          <li>
            <a href={item.link}>
              <span class="t">{item.title}</span>
              <span class="d">{item.detail}</span>
              <Icon name="arrow-right" class="arr" />
            </a>
          </li>
        ))}
      </ul>
      <div class="how">
        <h3>{blok.modalities_heading}</h3>
        <p>{blok.modalities}</p>
        <a class="text-link" href={blok.modalities_link}>All treatments<Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .conditions { background: var(--stone); }
  .layout { display: grid; grid-template-columns: 0.85fr 1fr; gap: clamp(40px, 7vw, 120px); }
  .lede { margin-top: 20px; }
  .photo { margin: clamp(32px, 4vw, 56px) 0 0; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 5; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .list a {
    display: grid; grid-template-columns: 1fr auto; grid-template-areas: 't arr' 'd arr';
    gap: 4px 24px; align-items: center;
    padding: 24px 4px; border-bottom: 1px solid var(--rule); text-decoration: none;
    transition: padding 0.4s var(--ease-out), background-color 0.3s;
  }
  .t { grid-area: t; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.2; }
  .d { grid-area: d; color: var(--ink-2); font-size: 0.975rem; }
  .list :global(.arr) { grid-area: arr; width: 22px; height: 22px; color: var(--jade); transition: transform 0.4s var(--ease-out); }
  .list a:hover { padding-left: 14px; background: var(--paper); }
  .list a:hover :global(.arr) { transform: translateX(4px); }
  .how { margin-top: clamp(40px, 5vw, 64px); max-width: 52ch; }
  .how h3 { font-size: var(--step-1); font-family: var(--font-body); font-weight: 600; letter-spacing: 0; }
  .how p { margin: 8px 0 16px; color: var(--ink-2); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .photo { aspect-ratio: 16 / 10; }
  }
</style>
