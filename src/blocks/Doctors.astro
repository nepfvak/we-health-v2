---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { photos } from '../lib/images';
import type { Block } from '../lib/content';

interface Props { blok: Block }
const { blok } = Astro.props;
---
<section class="section doctors" id="doctors">
  <div class="wrap">
    {blok.heading && (
      <header class="head" data-reveal>
        <h2>{blok.heading}</h2>
        <p class="lede">{blok.intro}</p>
      </header>
    )}
    <div class="grid">
      {blok.doctors.map((d: Block) => (
        <article class="doc" data-reveal>
          <div class="portrait" style={`--zoom:${d.photo_zoom ?? 1};--pos:${d.photo_position ?? '50% 30%'}`}>
            <Image src={photos[d.photo]} alt={`Portrait of ${d.name}`} widths={[320, 480, 640, 800]} quality={85} sizes="(max-width: 700px) 40vw, 240px" />
          </div>
          <div class="body">
            <h3>{d.name}</h3>
            <p class="deg">{d.degrees}</p>
            <p class="focus">{d.focus}</p>
            <ul>
              {d.credentials.map((c: string) => <li>{c}</li>)}
            </ul>
            <a class="text-link" href={d.link}>Full background<Icon name="arrow-right" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: grid; grid-template-columns: 1.1fr 1fr; gap: 24px 64px; align-items: end; }
  .head .lede { justify-self: end; }
  .grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 5vw, 80px);
  }
  .head + .grid { margin-top: clamp(48px, 6vw, 80px); }
  .doc { display: grid; grid-template-columns: minmax(140px, 240px) 1fr; gap: clamp(20px, 2.5vw, 36px); align-items: start; }
  .portrait { width: 100%; aspect-ratio: 3 / 4; border-radius: var(--radius-sm); overflow: hidden; background: var(--stone); }
  .portrait :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: var(--pos);
    transform: scale(var(--zoom)); transform-origin: var(--pos);
  }
  h3 { font-size: var(--step-2); }
  .deg { margin-top: 6px; font-weight: 600; color: var(--ink-2); font-size: var(--step--1); }
  .focus { margin-top: 14px; color: var(--ink-2); }
  ul { list-style: none; margin: 20px 0 24px; padding: 0; border-top: 1px solid var(--rule); }
  li { padding: 12px 0; border-bottom: 1px solid var(--rule); font-size: 0.975rem; line-height: 1.5; }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: 1fr; max-width: 760px; }
  }
  @media (max-width: 760px) {
    .head { grid-template-columns: 1fr; }
    .head .lede { justify-self: start; }
  }
  @media (max-width: 520px) {
    .doc { grid-template-columns: 1fr; }
    .portrait { width: 62%; }
  }
</style>
