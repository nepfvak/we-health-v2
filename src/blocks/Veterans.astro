---
import Icon from '../components/Icon.astro';
import type { Block } from '../lib/content';

interface Props { blok: Block }
const { blok } = Astro.props;
---
<section class="section veterans on-pine" id={blok.anchor}>
  <div class="wrap layout">
    <div class="copy">
      <h2 data-reveal>{blok.heading}</h2>
      <p class="body">{blok.body}</p>
      <a class="btn btn-outline" href={blok.cta_link}>{blok.cta_label}<Icon name="arrow-right" /></a>
    </div>
    <ol class="steps">
      {blok.steps.map((s: Block, i: number) => (
        <li data-reveal>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .veterans { background: var(--pine); color: var(--on-pine); }
  .layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 112px); align-items: start; }
  h2 { max-width: 16ch; }
  .body { margin: 24px 0 36px; font-size: var(--step-1); line-height: 1.55; color: var(--on-pine-2); max-width: 46ch; }
  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--pine-2); }
  .steps li {
    display: grid; grid-template-columns: 56px 1fr; gap: 20px;
    padding: 28px 0; border-bottom: 1px solid var(--pine-2);
  }
  .n {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--on-pine-2);
    display: grid; place-items: center; font-family: var(--font-display); font-size: 1.25rem;
  }
  h3 { font-size: var(--step-1); line-height: 1.3; }
  .steps p { margin-top: 6px; color: var(--on-pine-2); }

  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
</style>
